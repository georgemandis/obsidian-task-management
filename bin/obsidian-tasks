#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so the tool works when linked onto PATH. macOS has no
# readlink -f, so walk the links manually.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"   # relative link -> absolute
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
source "$ROOT/lib/obsidian.sh"
source "$ROOT/lib/render.sh"
source "$ROOT/lib/fetch.sh"
source "$ROOT/lib/cleanup.sh"

usage() {
  cat <<'EOF'
obsidian-tasks — manage Obsidian tasks from the terminal

Usage:
  obsidian-tasks by-date [--created] [--all] [--since <n>d]
  obsidian-tasks by-file [--all]
  obsidian-tasks pick    [--created] [--all] [--since <n>d]
  obsidian-tasks toggle <ref> [--done|--todo]
  obsidian-tasks clean-up [--older-than <n>d] [--dry-run]

Options:
  --created      Group by file creation date instead of modification date
  --all          Include completed tasks (default: open tasks only)
  --since <n>d   Only files touched within the last n days
  --older-than <n>d  clean-up: only notes whose filename date is older than n days (default 7)
  --dry-run      clean-up: print what would change, change nothing

clean-up removes two kinds of noise from dated notes older than the window:
  - empty checkboxes left by templates ("- [ ]" with no text) are deleted;
  - past meetings on a daily note's agenda ("- [ ] 11:30 – 12:00 [[...]]") are ticked.
Notes with no YYYY-MM-DD in their path are never touched.

Listings skip paths in <vault>/.obsidian-tasks-ignore (one prefix per line,
# comments); without that file, _/Templates/ is skipped.

Environment:
  OBSIDIAN_TASKS_DRY_RUN=1   Print write commands instead of running them
  OBSIDIAN_TIMEOUT=<secs>    CLI timeout (default 25)

Targets whichever vault Obsidian currently has focused.
EOF
}

cmd="${1:-}"
[[ -n "$cmd" ]] || { usage >&2; exit 1; }
shift || true

case "$cmd" in
  -h|--help|help) usage; exit 0 ;;

  by-date|pick)
    field="modified"; all=0; since=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --created) field="created"; shift ;;
        --all)     all=1; shift ;;
        --since)
          if [[ -z "${2:-}" ]]; then
            printf -- '--since requires a value, e.g. --since 7d\n' >&2; exit 1
          fi
          since="${2%d}"
          if [[ ! "$since" =~ ^[0-9]+$ ]]; then
            printf -- '--since expects a number of days, e.g. 7d (got: %s)\n' "$2" >&2; exit 1
          fi
          shift 2 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 1 ;;
      esac
    done

    enriched="$(fetch_enriched "$all")"
    if [[ "$(jq -r 'length' <<< "$enriched")" == "0" ]]; then
      printf 'No tasks found.\n'; exit 0
    fi

    if [[ "$cmd" == "by-date" ]]; then
      printf '%s' "$enriched" | render_by_date "$field" "$since"
    else
      run_picker "$enriched" "$field" "$all" "$since"
    fi
    ;;

  by-file)
    all=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --all) all=1; shift ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 1 ;;
      esac
    done
    tasks="$(fetch_tasks "$all")" || exit 1
    printf '%s' "$tasks" | filter_ignored | render_by_file
    ;;

  clean-up)
    older=7; dry=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --older-than)
          if [[ -z "${2:-}" ]]; then
            printf -- '--older-than requires a value, e.g. --older-than 7d\n' >&2; exit 1
          fi
          older="${2%d}"
          if [[ ! "$older" =~ ^[0-9]+$ ]]; then
            printf -- '--older-than expects a number of days, e.g. 7d (got: %s)\n' "$2" >&2; exit 1
          fi
          shift 2 ;;
        --dry-run) dry=1; shift ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 1 ;;
      esac
    done
    [[ $dry -eq 1 ]] && export OBSIDIAN_TASKS_DRY_RUN=1
    cutoff="$(cleanup_cutoff "$older")"
    tasks="$(fetch_tasks 0)" || exit 1
    plan="$(printf '%s' "$tasks" | filter_ignored | cleanup_plan "$cutoff")"
    if [[ -z "$plan" ]]; then
      printf 'Nothing to clean up (dated notes older than %s).\n' "$cutoff"; exit 0
    fi
    printf 'Cutoff %s: %s empty checkbox(es) to delete, %s past agenda line(s) to tick.\n' \
      "$cutoff" "$(printf '%s\n' "$plan" | grep -c '^delete-empty')" \
      "$(printf '%s\n' "$plan" | grep -c '^done-agenda')"
    printf '%s\n' "$plan" | cleanup_apply
    ;;

  toggle)
    ref="${1:-}"
    [[ -n "$ref" ]] || { printf 'toggle requires a ref (path:line)\n' >&2; exit 1; }
    shift
    verb="toggle"
    case "${1:-}" in
      --done) verb="done" ;;
      --todo) verb="todo" ;;
      "")     ;;
      *) printf 'Unknown option: %s\n' "$1" >&2; exit 1 ;;
    esac
    obs_task_write "$ref" "$verb"
    ;;

  *) printf 'Unknown command: %s\n' "$cmd" >&2; usage >&2; exit 1 ;;
esac
